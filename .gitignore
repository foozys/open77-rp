# Белый список: в репозитории только наш код и конфиги сервера.
# Бинарники, платформенные ресурсы и .open77/ (ключи подписи, кэш) не коммитим.
/*
!/.gitignore
!/README.md
!/PROJECT_CONTEXT.md
!/CLAUDE.md
!/HANDOFF-CLAUDE.md
!/UI-REDESIGN.md
!/RIPPER-UI-REDESIGN.md
!/.claude/
!/.claude/rules/
!/.claude/rules/*.md
!/docs/
!/docs/*.md
!/TESTING-2P.md
!/DOCS.md
!/server.jsonc
!/acl.jsonc
!/Start-Logged.cmd
!/tools/

!/resources/
/resources/*
!/resources/rp/
/resources/rp/rp_clothes/dist/

# Claude Code local sessions, credentials and machine-specific settings.
/.claude/settings.local.json
/.claude/projects/
/.claude/history/
/.claude/todos/

# Official Open77 server-package docs copied with the dedicated server (not project docs).
/docs/metrics.md
/docs/rcon.md
/docs/server-configuration.md
/docs/server-query.md
